# Copy to .env and fill in.

PORT=8200
HOST=0.0.0.0

# guacamole-lite encrypts connection tokens with AES-256-CBC. EXACTLY 32
# characters — a wrong length fails deep in the crypt layer at first connect
# with an opaque error, so the server refuses to start instead.
#   openssl rand -hex 16
GUAC_KEY=

# guacd. Run it next to this service:
#   docker run -d --name guacd --restart unless-stopped \
#     -p 127.0.0.1:4822:4822 guacamole/guacd
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

# Where the device inventory lives. Holds credentials — keep it out of git.
DEVICES_FILE=./devices.json

# How often each device is TCP-probed for presence.
PRESENCE_INTERVAL_MS=5000
